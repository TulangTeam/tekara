def Xform "Root"
{
    reorder nameChildren = ["SkySphere", "Materials", "Scene"]
    def Xform "Materials" (
        active = true
    )
    {
        reorder nameChildren = ["Sand_Material", "Water_Material", "Dome_Material"]
        float2 ui:nodegraph:node:pos = (20, 20)
        int ui:nodegraph:node:stackingOrder = 1
        quatf xformOp:orient = (1, 0, 0, 0)
